# Admin dashboard — first login uses env credentials, then manage users in Dashboard → Users
ADMINUSERNAME=admin
ADMINPASS=your-secure-password
# Optional session signing fallback (auto-generated if empty)
ADMIN_SESSION_SECRET=your-long-random-secret

# MongoDB
MONGODB_URI=your-mongodb-connection-string
BDNAME=nexa_e-commerce

# ImageKit
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Steadfast Courier API — optional fallback; admin Settings → Steadfast থেকেও configure করা যায়
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Meta (Facebook) Pixel — optional fallback; admin Settings page থেকেও পরিবর্তন করা যায়
NEXT_PUBLIC_META_PIXEL_ID=
