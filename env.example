# Admin dashboard login only (not for customers)
ADMINUSERNAME=admin
ADMINPASS=your-secure-password

# MongoDB
MONGODB_URI=your-mongodb-connection-string
BDNAME=nexa_e-commerce

# ImageKit
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Steadfast Courier API (https://steadfast.com.bd/user/api)
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key

# Meta (Facebook) Pixel — Events Manager → Data Sources → Pixel ID (শুধু সংখ্যা)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
